---
import Layout from "@layouts/Layout.astro";
import SubpageContent from "@components/projects/SubpageContent.astro";
import Chip from "@components/chips/Chip.astro";
import ChipGroup from "@components/chips/ChipGroup.astro";
import Wave from "@components/visuals/Wave.astro";
import Button from "@components/Button.astro";
---

<Layout
  title="Kompendium"
  description="In memory of my friend Konrad Rauscher, Kompendium is a digital archive of his over 800 Spotify playlists created over 11 years."
  activePage="projects"
  ogURL="https://conorkelley.me/projects/kompendium"
>
  <SubpageContent title="Kompendium">
    <ChipGroup slot="languages">
      <Chip abbr="sveltekit" />
      <Chip abbr="ts" />
      <Chip abbr="css" />
      <Chip abbr="py" />
    </ChipGroup>

    <!-- Column 1 -->
    <p slot="col-1">
      <a href="https://komp3nd1um.app" target="_blank">Kompendium</a> is a digital preservation of my
      friend Konrad Rauscher's immense musical curation that he shared with countless friends, family
      and strangers over 11 years. Between 2013 and 2024, he crafted 826 original public Spotify playlists
      totaling 59,903 songs. Konrad tragically passed away in October 2024.
    </p>
    <p slot="col-1">
      I collected, cleaned, and sorted all playlist data from Konrad's Spotify profile to prepare it
      for the web. <a href="https://github.com/contreau/konrad-playlist-archive" target="_blank"
        >View the code</a
      > from that process if you're interested.
    </p>
    <div slot="col-1">
      <Button url="https://komp3nd1um.app" target="_blank">Visit Kompendium</Button>
    </div>

    <!-- Column 2 -->
    <Wave slot="col-2" minwidth="250px" minheight="250px" maxWaveHeight="200" speed="0.05" />
  </SubpageContent>
</Layout>
