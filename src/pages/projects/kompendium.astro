---
import Layout from "@layouts/Layout.astro";
import SubpageContent from "@components/projects/SubpageContent.astro";
import Chip from "@components/chips/Chip.astro";
import Wave from "@components/visuals/Wave.astro";
import Button from "@components/Button.astro";
---

<Layout
  title="Kompendium"
  description="In memory of my friend Konrad Rauscher, Kompendium is a digital archive of his over 800 Spotify playlists created over 11 years."
  activePage="projects"
  ogURL="https://conorkelley.me/projects/kompendium"
>
  <SubpageContent title="Kompendium">
    <Chip slot="languages" abbr="sveltekit" />
    <Chip slot="languages" abbr="ts" />
    <Chip slot="languages" abbr="css" />
    <Chip slot="languages" abbr="py" />

    <div slot="content" class="content grid">
      <div class="grid-col">
        <p class="description">
          <a href="https://komp3nd1um.app" target="_blank">Kompendium</a> is a digital preservation of
          my friend Konrad Rauscher's immense musical curation that he shared with countless friends,
          family and strangers over 11 years. Between 2013 and 2024, he crafted 826 original public Spotify
          playlists totaling 59,903 songs. Konrad tragically passed away in October 2024.
        </p>
        <p class="description">
          I collected, cleaned, and sorted all playlist data from Konrad's Spotify profile to
          prepare it for the web. <a
            href="https://github.com/contreau/konrad-playlist-archive"
            target="_blank">View the code</a
          > from that process if you're interested.
        </p>

        <div>
          <Button url="https://komp3nd1um.app" target="_blank">Visit Kompendium</Button>
        </div>
      </div>
      <div class="grid-col">
        <Wave minwidth="250px" minheight="250px" maxWaveHeight="200" speed="0.05" />
      </div>
    </div>
  </SubpageContent>
</Layout>

<style>
  div.content * {
    margin-block: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .grid-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .grid-col:nth-of-type(2) {
    grid-row-start: 1;
    align-self: center;
    justify-self: center;
  }

  @media (max-width: 1100px) {
    .grid {
      row-gap: 2rem;
      margin-top: 2rem;
    }

    div.content * {
      margin-inline: auto;
    }
  }

  @media (width >= 1100px) {
    .grid {
      grid-template-columns: 60% auto;
    }

    .grid-col:nth-of-type(2) {
      grid-column-start: 2;
    }
  }
</style>
