---
import Layout from "@layouts/Layout.astro";
import Chip from "@components/chips/Chip.astro";
import ChipGroup from "@components/chips/ChipGroup.astro";
import SubpageContent from "@components/projects/SubpageContent.astro";
import RCstats from "@components/visuals/RedcapStats.astro";
const title = "REDCap Module - File Type Enforcement";
---

<Layout
  {title}
  description="An official external module I developed for REDCap, a web application for building and managing online surveys and databases."
  activePage="projects"
  ogURL="https://conorkelley.me/projects/redcap"
>
  <SubpageContent {title}>
    <ChipGroup slot="languages">
      <Chip abbr="php" />
      <Chip abbr="js" />
    </ChipGroup>

    <!-- Column 1 -->
    <p slot="col-1">
      <a href="https://github.com/contreau/redcap-filetype-enforcement-module" target="_blank"
        >An external module I developed</a
      > and maintain for REDCap, a web application for building and managing online surveys and databases
      that is used by over 8,300 active institutions in 160+ countries.
    </p>
    <p slot="col-1">
      Having built several REDCap webforms for use at the GW School of Medicine & Health Sciences, I
      observed that there is no native way to strictly enforce types for uploaded files. To remedy
      this, I developed an opt-in module that allows form builders to easily restrict file uploads
      so that end-users can only submit permitted file types.
    </p>
    <p slot="col-1">The module was accepted by the Vanderbilt REDCap team in May 2026.</p>

    <!-- Column 2 -->
    <RCstats slot="col-2" />
  </SubpageContent>
</Layout>
