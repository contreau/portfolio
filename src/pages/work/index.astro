---
import Layout from "@layouts/Layout.astro";
import PortfolioSection from "@components/projects/PortfolioSection.astro";
import Chip from "@components/chips/Chip.astro";
import Button from "@components/Button.astro";
---

<Layout
  activePage="work"
  title="Work"
  ogURL="https://conorkelley.me/work"
  description="Professional web development experience."
>
  <h2>Work History</h2>
  <PortfolioSection
    heading="GW Academic Medical Enterprise"
    title="Web Associate"
    timeline="October 2022 - August 2026"
  >
    <div class="content grid" slot="content">
      <p class="description">
        <em>
          Spearheaded frontend development and provided operational support for the web ecosystem of
          The George Washington University's academic medical enterprise - consisting of the GW MFA
          (now <a href="https://capitalmedicalgroup.com" target="_blank">Capital Medical Group</a>)
          and the <a href="https://smhs.gwu.edu/" target="_blank"
            >GW School of Medicine & Health Sciences</a
          >.
        </em>
      </p>

      <div><Button url="/work/gw">View Featured Projects</Button></div>

      <h4 class="no-margin-top">Accolades</h4>
      <ul>
        <li>
          <a href="/pillar-award.pdf" target="_blank">GW Medicine Pillars of Excellence Award</a> • February
          2026
        </li>
      </ul>

      <h4>Key Responsibilities</h4>
      <ul>
        <li>Patient-facing UI/UX enhancement</li>
        <li>Webform development and maintenance</li>
        <li>Creation of automation tools</li>
        <li>Accessibility audits per WCAG</li>
      </ul>
    </div>
    <div class="languages">
      <Chip abbr="drupal" /><Chip abbr="redcap" /><Chip abbr="vue" /><Chip abbr="css" /><Chip
        abbr="js"
      /><Chip abbr="ts" /><Chip abbr="php" /><Chip abbr="node" />
    </div>
  </PortfolioSection>

  <PortfolioSection
    heading="Boston University School of Medicine"
    title="Web Designer"
    timeline="January - August 2022"
    marginTop="true"
  >
    <div class="languages">
      <Chip slot="chip" abbr="wp" />
      <Chip slot="chip" abbr="css" />
    </div>
    <p slot="content" class="description">
      <em>
        Redesigned and rebuilt two Boston University School of Medicine websites (a department site
        and an administrative site) on WordPress. Collaborated with faculty on feature and design
        needs, wrote extensive custom CSS and UI components, and created site assets, including
        photographing staff headshots and other imagery.
      </em>
    </p>

    <div slot="content">
      <h4>Websites Worked</h4>
      <ul>
        <li>BUSM Department of Pharmacology & Biophysics</li>
        <li>BUSM Office of Financial & Grants Administration</li>
      </ul>
    </div>
  </PortfolioSection>
</Layout>

<style>
  .grid {
    display: grid;
  }

  h4 {
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .projects.no-visuals {
    gap: 2.5rem;
  }

  .description,
  li {
    text-wrap: balance;
  }

  li + li {
    margin-top: 1rem;
  }

  @media (max-width: 1100px) {
    h2,
    h4 {
      text-align: center;
    }

    .content * {
      margin-inline: auto;
    }
  }
</style>
