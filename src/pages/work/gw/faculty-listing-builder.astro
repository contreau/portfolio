---
import Layout from "@layouts/Layout.astro";
import Chip from "@components/chips/Chip.astro";
import SubpageContent from "@components/projects/SubpageContent.astro";
const description =
  "A GUI tool enabling quick generation of a faculty member's profile HTML to aid in updating any SMHS department faculty pages.";
---

<Layout
  title="Faculty Listing Builder"
  description={description}
  ogURL="https://conorkelley.me/gwmedicine/faculty-listing-builder"
  activePage="work"
>
  <link
    slot="image-preload"
    rel="preload"
    href="/faculty-builder-min.gif"
    as="image"
    type="image/gif"
  />

  <SubpageContent title="Faculty Listing Builder" alternativeGridCols>
    <Chip slot="languages" abbr="vue" />
    <Chip slot="languages" abbr="ts" />
    <Chip slot="languages" abbr="css" />
    <Chip slot="languages" abbr="php" />

    <div slot="full-width-description" class="description-fw">
      <p>
        A GUI tool I built for our web team allowing for quick generation of a faculty member's
        profile HTML. Used to assist in updating any of the 39 <a
          href="https://neurology.smhs.gwu.edu/faculty"
          target="_blank">faculty pages</a
        > across the School of Medicine & Health Sciences websites.
      </p>
      <p>
        I wrote user authentication in PHP and deployed the application on a private Apache server.
      </p>
    </div>

    <div slot="col-1" class="grid-item">
      <h3>Key features:</h3>
      <ul class="features-list">
        <li>Live preview as you type for both UI and HTML views.</li>
        <li>
          CSV processor that populates the tool's inputs with a given faculty member's information
          upon selecting their name. Allows for filtering by department.
        </li>
        <li>Keyboard shortcuts for adding and deleting titles and bulleted information.</li>
        <li>Single-click copying of the generated HTML.</li>
      </ul>
    </div>

    <div slot="col-2" class="demo">
      <img
        src="/faculty-builder-min.gif"
        alt="Faculty Listing Builder Demo"
        height="500"
        width="1165"
        loading="eager"
      />
    </div>
  </SubpageContent>
</Layout>

<style>
  h3 {
    margin-block: 0.5rem;
  }

  div.description-fw p + p {
    margin-top: 2rem;
  }

  .features-list {
    text-wrap: balance;
    padding-left: 0;
    list-style-position: inside;
  }

  .features-list li + li {
    margin-top: 1rem;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 33% 65%;
    column-gap: 2%;
    place-items: center;
    margin-block: 1.5rem;
  }

  @media (max-width: 1100px) {
    .demo {
      order: -1;
    }
    h3 {
      text-align: center;
    }
    .features-list {
      text-wrap: wrap;
    }
  }
</style>
