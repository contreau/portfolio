---
import ASCII from "./visuals/ASCII.astro";
---

<div class="container">
  <div class="text">
    <p>
      I'm an Associate Web Developer at <a href="https://uhs.com/" target="_blank">UHS</a> based in NYC.
      Previously I worked in the intersection of healthcare and higher education at GW's academic medical
      enterprise.
    </p>
    <p>
      I've built UI components, custom tooling, websites, and applications that serve patients,
      doctors, administrators, and students.
    </p>

    <p>
      I'm an official contributor to <a href="https://project-redcap.org/" target="_blank"
        >REDCap software</a
      >, for which I developed and independently maintain an <a href="/projects/redcap"
        >external module</a
      >.
    </p>

    <p>Otherwise, catch me playing volleyball around the city 🏐</p>
  </div>

  <ASCII />
</div>

<style>
  .text p:first-of-type {
    margin-top: 0;
  }

  /* 'About' section */
  .container {
    text-wrap: balance;
    position: relative;
    opacity: 0;
    transform: translateY(-10px);
    display: grid;
    grid-template-columns: 70% 25%;
    place-items: end;
    align-items: start;
    gap: 5%;
    animation: fadeIn 500ms ease-in forwards;

    p {
      margin-block: 1rem;
    }

    a {
      color: var(--primary-link);
    }
  }

  h2 {
    margin-bottom: 3rem;
  }

  h2 span.blink-cursor {
    animation: cursor 1s infinite;
  }

  /* @ rules */

  @keyframes cursor {
    0% {
      opacity: 0;
    }

    20% {
      opacity: 0;
    }

    75% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  @media (max-width: 800px) {
    .container p {
      text-align: center;
    }
  }

  @media (max-width: 600px) {
    .container p {
      text-wrap: balance;
    }
  }

  @media (max-width: 1100px) {
    .container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (min-width: 1200px) {
    .container {
      animation:
        fadeIn 500ms ease-in forwards,
        shiftDown 500ms ease-in forwards;
    }
  }
</style>
