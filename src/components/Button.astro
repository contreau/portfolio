---
const { url, target = "_self", marginInline } = Astro.props;

interface Props {
  url: string;
  target?: string;
  marginInline?: string;
}
---

<a href={url} target={target}><slot /></a>

<style define:vars={{ marginInline: marginInline }}>
  a {
    display: block;
    margin-inline: var(--marginInline);
    max-width: fit-content;
    color: var(--text);
    text-decoration: none;
    border: solid 1.5px var(--primary);
    border-radius: 5px;
    padding: 0.25em 1em;
    font-weight: 500;
    transition: 0.3s all;
  }

  a:hover {
    background-color: #728bd23b;
  }
</style>
