---
const { heading, title, timeline, marginTop } = Astro.props;
interface Props {
  heading: string;
  title: string;
  timeline?: string;
  marginTop?: string;
}
---

<section class:list={[{ "margin-top": marginTop === "true" }]}>
  <div class="heading-timeline">
    <h3>{heading}</h3>
    <span class="timeline">{timeline}</span>
  </div>
  <span class="title">{title}</span>
  <slot name="content" />
  <slot />
</section>

<style>
  span.title {
    font-weight: 150;
    font-size: 1.25rem;
    color: #f9de8d;
  }

  section.margin-top {
    margin-top: 3rem;
  }

  .heading-timeline {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  .heading-timeline h3 {
    margin-block: 0;
    text-wrap: balance;
  }

  .timeline {
    background-color: var(--bg-color);
    border: solid 1.5px #728bd24f;
    /* margin-top: 0.5rem; */
    display: inline-block;
    /* align-self: flex-start; */
    font-size: 0.8rem;
    font-weight: 550;
    padding: 0.1em 1em;
    color: #ffffff;
    border-radius: 30px;
  }

  .timeline:empty {
    display: none;
  }

  p.description {
    margin-block: 1.5rem;
    max-width: 80%;
  }

  @media (max-width: 1100px) {
    .heading-timeline {
      flex-direction: column;
      text-align: center;
      align-items: center;
      gap: 1rem;
    }

    .timeline {
      align-self: center;
    }

    span.title {
      display: block;
      text-align: center;
      margin-top: 1rem;
    }

    h2 {
      text-wrap: balance;
    }

    p.description {
      max-width: 100%;
      text-align: center;
    }
  }
</style>
