---
const { colLimit } = Astro.props;
---

<div class:list={[{ default: !colLimit }, { colLimit: colLimit }]}>
  <slot />
</div>

<style define:vars={{ colLimit: colLimit }}>
  div.default {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  div.colLimit {
    display: grid;
    grid-template-columns: repeat(var(--colLimit), max-content);
  }
</style>
