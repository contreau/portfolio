---
import StatsSVG from "@svg/StatsSVG.astro";
import LoadingSVG from "@svg/LoadingSVG.astro";
---

<script>
  interface ModuleStats {
    installs: number;
    institutions: number;
    totalProjects: number;
  }

  (async () => {
    async function getModuleStats() {
      const res = await fetch(
        "https://redcap.vumc.org/consortium/modules/stats-single.php?module_name=filetype_enforcement",
      );
      if (res.status !== 200) {
        const responseMessage = document.querySelector("p#response-status")!;
        responseMessage.textContent = "Network Error in fetching stats. Try again.";
        return;
      }
      const html = await res.text();
      return html;
    }

    const statsHTML = await getModuleStats();
    if (statsHTML) {
      const statsDOM = new DOMParser().parseFromString(statsHTML, "text/html");
      const formattingPromise = new Promise((resolve) => {
        const moduleStats: ModuleStats = {
          installs: 0,
          institutions: 0,
          totalProjects: 0,
        };

        statsDOM
          .querySelectorAll<HTMLElement>("tr.indent-1:not(tr.version-header) td")
          .forEach((td, i) => {
            switch (i) {
              // acceptable indices: 0, 2, 3, 4 (if 3 or 4, add value to totalProjects)
              case 0:
                moduleStats.installs = parseInt(td.textContent);
                break;
              case 2:
                moduleStats.institutions = parseInt(td.textContent);
                break;
              case 3:
                moduleStats.totalProjects += parseInt(td.textContent);
                break;
              case 4:
                moduleStats.totalProjects += parseInt(td.textContent);
                break;
            }
          });

        // update textContent in span.stat-value nodes with moduleStats values
        Array.from(document.querySelectorAll("#stats-list li span.stat-value")!).map((span, i) => {
          const key = Object.keys(moduleStats)[i] as keyof ModuleStats;
          span.textContent = moduleStats[key].toString();
        });
        resolve(true);
      });
      await formattingPromise;
      const loadingCover = document.querySelector("div#loading-cover");
      loadingCover?.classList.remove("visible");
      loadingCover?.classList.add("hidden");
    }
  })();
</script>

<aside>
  <h3><StatsSVG /> Usage Stats</h3>
  <p id="source">
    Source: <a href="https://redcap.vumc.org/consortium/modules/index.php" target="_blank"
      >REDCap Repo</a
    >
  </p>
  <div id="stats-container">
    <ul id="stats-list">
      <div id="loading-cover" class="visible"><LoadingSVG /></div>
      <li id="installs"><span class="stat-value"></span> all-time installs</li>
      <li id="institutions"><span class="stat-value"></span> active institutions</li>
      <li id="total_projects"><span class="stat-value"></span> total projects</li>
    </ul>
  </div>
</aside>

<style>
  aside {
    margin-inline: auto;
    margin-top: 1.5rem;
    border-radius: 15px;
    max-width: 350px;
    padding-inline: 1.5em;
    h3 {
      margin-block: 0;
      text-align: center;
      font-weight: 200;
    }
  }

  p#source {
    margin-block: 0.25rem;
    text-align: center;
    font-size: 0.75rem;
  }

  ul#stats-list,
  #loading-cover {
    border-radius: 15px;
    background-color: #1b2439;
    padding-block: 0.5em;
  }

  ul#stats-list {
    position: relative;
    padding-left: 2em;
    margin-top: 0.5rem;
  }

  #loading-cover {
    position: absolute;
    content: "";
    z-index: 5;
    inset: 0;
    color: #baccff;
    text-align: center;
    align-content: center;
    transition: opacity 0.35s;
    font-size: 1.2rem;
    font-weight: 300;
  }

  span.stat-value {
    color: #baccff;
    font-weight: 450;
  }

  .hidden {
    opacity: 0;
  }

  .visible {
    opacity: 1;
  }
</style>
